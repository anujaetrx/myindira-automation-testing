{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@config/*": ["./config/*"],
      "@api/*": ["./src/api/*"],
      "@android/*": ["./src/android/*"],
      "@mobile/*": ["./src/mobile/*"],
      "@ios/*": ["./src/ios/*"],
      "@auth/*": ["./src/auth/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@fixtures": ["./src/fixtures/index.ts"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@pwa/*": ["./src/pwa/*"],
      "@data/*": ["./src/test-data/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["config", "src", "tests", "scripts", "playwright.config.ts"],
  "exclude": ["node_modules", "reports", "artifacts"]
}
