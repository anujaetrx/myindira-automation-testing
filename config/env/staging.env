BASE_URL=https://app-test.k.indiraiscm.com
# Same gateway the app calls (its host name says "staging-gw"). Confirm if staging should differ.
API_BASE_URL=https://staging-gw.k.indiraiscm.com
API_PATH_PREFIX=/myindiranew/api
# The app signs users in through Microsoft SSO, so there is no API login: use the UI flow.
AUTH_STRATEGY=ui
AUTH_PROVIDER=microsoft
AUTH_TOKEN_LOCATION=localStorage
AUTH_TOKEN_KEY=internal_token
AUTH_ME_ENDPOINT=/auth/me
# Where each API header's value comes from (names only, no secrets).
AUTH_API_HEADERS='{"Authorization":"Bearer ${ls:sso_token}","x-auth-token":"${ls:internal_token}","tokentype":"employee","x-client-app":"myindira-ui","email":"${ls:user_profile.officialEmail}","userrole":"${role}"}'
LOG_LEVEL=info
