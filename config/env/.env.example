# Copy to config/env/<env>.local.env for secrets (git-ignored), or set these in CI secrets.
# Non-secret values live in dev.env / qa.env / staging.env (committed).
#
# In CI you can hold several environments at once with a prefix:
#   QA_ADMIN_PASSWORD, STAGING_ADMIN_PASSWORD ... (prefix wins over the unprefixed name)

# ---- Credentials (SECRETS - never commit real values) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
USER_USERNAME=
USER_PASSWORD=

# ---- Auth behaviour (non-secret, may live in <env>.env) ----
# ui | api | auto (auto = API login, falls back to UI login)
AUTH_STRATEGY=auto
AUTH_LOGIN_ENDPOINT=/auth/login
# Leave empty if the backend has no logout endpoint (session is then just discarded)
AUTH_LOGOUT_ENDPOINT=
AUTH_ME_ENDPOINT=/users/me
# Where the app keeps its token: localStorage | cookie
AUTH_TOKEN_LOCATION=localStorage
AUTH_TOKEN_KEY=token
AUTH_SESSION_TTL_MINUTES=30
AUTH_EXPIRY_SKEW_SECONDS=60
# Also ask the server whether a cached session is still valid (one extra request per check)
AUTH_VALIDATE_REMOTE=false

# ---- General ----
TEST_ENV=qa
LOG_LEVEL=info
HEADLESS=true
