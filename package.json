{
  "name": "myindira-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright + TypeScript automation framework for the MyIndira PWA",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:pwa": "playwright test --grep @pwa",
    "test:api": "playwright test --project=api",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test tests/e2e",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "clean": "ts-node scripts/clean-artifacts.ts",
    "merge:reports": "ts-node scripts/merge-reports.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:android": "playwright test --project=android-pixel7 --project=android-galaxy-s9 --project=android-small-pixel2 --project=android-tablet",
    "test:android:device": "cross-env RUN_ANDROID_DEVICE=true playwright test --project=android-device --workers=1",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/check-env.ps1",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/start-emulator.ps1",
    "android:avd": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/create-avd.ps1",
    "test:ios": "playwright test --project=ios-iphone-se --project=ios-iphone-14 --project=ios-iphone-15-pro-max --project=ios-ipad"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  }
}
